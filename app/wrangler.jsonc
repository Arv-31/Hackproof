{
  // HackProof is a static site: Cloudflare serves the built files from ./dist.
  "name": "hackproof",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  // Kept off until Cloudflare Access (the Gmail allow-list) protects the address.
  "workers_dev": false,
  "preview_urls": false
}
