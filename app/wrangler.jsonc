{
  // HackProof: static site in ./dist, served only after the password gate in worker/index.ts.
  "name": "hackproof",
  "compatibility_date": "2026-10-06",
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Every request goes through the gate first, including the files themselves.
    "run_worker_first": true
  },
  // Safe to keep on: the gate refuses everyone until SITE_PASSWORD is set.
  "workers_dev": true,
  "preview_urls": false
}
